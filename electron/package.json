{
  "name": "ziaida-palace-pms-desktop",
  "version": "1.0.0",
  "description": "Ziaida Palace PMS — application de bureau",
  "author": "Ziaida Palace & Spa",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ma.ziaidapalace.pms.desktop",
    "productName": "Ziaida Palace PMS",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "splash.html"],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
