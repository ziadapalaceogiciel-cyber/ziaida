# Copier ce fichier en .env sur le serveur (jamais le committer avec de vraies valeurs)

# Nom de domaine pointant vers l'IP du VPS (enregistrement DNS de type A)
# — utilisé uniquement pour un déploiement VPS + Docker Compose (voir DEPLOY.md).
DOMAIN=pms.votredomaine.ma

# Clé secrète protégeant l'API — générer avec: openssl rand -base64 32
API_KEY=change-moi-avec-une-vraie-cle-secrete

# Chaîne de connexion MongoDB Atlas (obligatoire pour un déploiement Render ou VPS
# avec base de données distante). Si absente, le serveur utilise automatiquement une
# base SQLite locale (server/data/ziada-palace.db) — pratique en développement, mais
# à éviter en production sur un hébergeur au disque non permanent (ex. Render gratuit).
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/
